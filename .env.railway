# Environment variables for Railway deployment
# Copy these to your Railway project environment settings and update the values

# Application Settings
APP_NAME=Team Task Manager
API_V1_PREFIX=/api/v1

# Security (REQUIRED - replace with a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection (Railway MySQL Plugin or External)
# Option 1: Using Railway MySQL Plugin (auto-populated by Railway)
# DATABASE_URL will be automatically set by Railway when you add MySQL plugin
# Format: mysql+pymysql://user:password@host:port/database

# Option 2: Using external MySQL (set these if not using Railway MySQL):
# MYSQL_USER=root
# MYSQL_PASSWORD=your-database-password
# MYSQL_HOST=your-database-host
# MYSQL_PORT=3306
# MYSQL_DATABASE=team_task_manager

# CORS Configuration (update for your production domain)
# Add your frontend domain here in production
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Startup Configuration
CREATE_TABLES_ON_STARTUP=true

# Admin Bootstrap Account (optional - remove after first login)
# Set these to create an admin user on first deployment
# ADMIN_NAME=Admin User
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=change-me-on-first-login
