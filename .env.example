# Team Task Manager Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
APP_NAME=Team Task Manager
API_V1_PREFIX=/api/v1

# Security - REQUIRED: Set to a long random secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DO NOT commit actual values to git
SECRET_KEY=change-me-to-a-long-random-secret

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === DATABASE CONFIGURATION ===
# PRODUCTION: Use DATABASE_URL (Railway, managed services)
# DATABASE_URL format: mysql+pymysql://user:password@host:port/database
# Railway MySQL plugin automatically provides this variable
DATABASE_URL=mysql+pymysql://user:password@host:port/database

# DEVELOPMENT: If DATABASE_URL not set, falls back to these variables
# These are ignored if DATABASE_URL is present
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=team_task_manager

# CORS Configuration
# Production: Update to match your Railway domain (use https://)
# Development: Can be localhost
# Comma-separated for multiple origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Startup Behavior
CREATE_TABLES_ON_STARTUP=true

# Optional: Bootstrap Admin Account
# Only set these on initial deployment to create an admin user
# Remove after first login to prevent re-initialization
# ADMIN_NAME=Admin User
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-now

